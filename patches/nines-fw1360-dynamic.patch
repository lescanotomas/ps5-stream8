+static pid_t find_pid_by_name(const char* proc_name)
+{
+    int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_PROC, 0};
+    size_t size = 0;
+    pid_t result = -1;
+
+    if (sysctl(mib, 4, NULL, &size, NULL, 0) || !size)
+        return -1;
+
+    char* buffer = malloc(size);
+    if (!buffer)
+        return -1;
+
+    if (!sysctl(mib, 4, buffer, &size, NULL, 0))
+    {
+        for (char* cursor = buffer; cursor < buffer + size;)
+        {
+            int struct_size = 0;
+            pid_t pid = -1;
+            memcpy(&struct_size, cursor, sizeof(struct_size));
+            if (struct_size <= KINFO_COMM_OFFSET ||
+                cursor + struct_size > buffer + size)
+                break;
+            memcpy(&pid, cursor + KINFO_PID_OFFSET, sizeof(pid));
+            if (!strncmp(cursor + KINFO_COMM_OFFSET, proc_name,
+                         KINFO_COMM_SIZE))
+            {
+                result = pid;
+                break;
+            }
+            cursor += struct_size;
+        }
+    }
+
+    free(buffer);
+    return result;
+}
